{
  "name": "pull-whois",
  "version": "1.1.1",
  "description": "Pull WHOIS — 轻量、生产级的 WHOIS / RDAP / DNS / IP / 历史 / 可用性查询 API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "whois",
    "rdap",
    "domain",
    "api",
    "dns",
    "ip",
    "uptime"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
