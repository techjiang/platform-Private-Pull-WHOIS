# 服务
PORT=3000
HOST=0.0.0.0
# 部署在反向代理（Nginx / Cloudflare 等）之后时设为 true，用于获取真实客户端 IP
TRUST_PROXY=false
# 逗号分隔的允许来源，* 表示全部
CORS_ORIGIN=*
LOG_LEVEL=info

# 可选：设置后，查询接口需要携带 x-api-key 或 Authorization: Bearer <key>
# 留空即为公开接口。也可在管理后台 /admin 动态创建密钥与切换鉴权开关。
API_KEYS=
# 首次启动（尚无后台数据）时是否要求 API Key；不设置时：API_KEYS 非空则要求，否则公开
# API_REQUIRE_KEY=false

# 管理后台（访问 /admin）
# 管理员账号密码：首次启动时写入 data/admin.json（scrypt 摘要，不保存明文），之后可在后台修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MS=43200000
# 网页端查询开关默认值（true/false），与 API 是否需要 Key 相互独立，可在后台切换
WEB_QUERY_ENABLED=true
# 可选：自定义管理数据文件路径
# ADMIN_DATA_FILE=./data/admin.json

# 缓存（毫秒）
CACHE_TTL_MS=600000
CACHE_AVAILABLE_TTL_MS=60000
CACHE_MAX_ENTRIES=2000

# 限流（每窗口每 IP 的请求数）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_KEY_MAX=600

# 上游超时（毫秒）
RDAP_TIMEOUT_MS=8000
WHOIS_TIMEOUT_MS=8000

# 是否跟随 WHOIS 注册商服务器 referral
WHOIS_FOLLOW_REFERRAL=true

# 批量查询上限
BATCH_MAX_DOMAINS=20

# 注册商目录（IANA + ICANN）
# 自定义快照文件路径，默认 ./data/registrars.json
# REGISTRARS_DATA_FILE=./data/registrars.json
# 同步周期，默认 24 小时
REGISTRARS_SYNC_TTL_MS=86400000
# 拉取上游列表的超时，默认 30 秒
REGISTRARS_SYNC_TIMEOUT_MS=30000
